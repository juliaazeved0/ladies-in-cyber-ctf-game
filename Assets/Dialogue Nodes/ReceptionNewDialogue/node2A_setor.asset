  m_Script: {fileID: 11500000, guid: fc344bf1847f7284ba70f62fdd0f60c5, type: 3}
  m_Name: node2A_setor
  m_EditorClassIdentifier: 
  question: "\u201CCiberseguran\xE7a? N\xE3o lembro de nenhum chamado hoje. Voc\xEA
    est\xE1 vinculada a algum setor?\u201D"
  options:
  - "\u201CVeio direto do time de TI, n\xE3o da recep\xE7\xE3o.\u201D"
  - "\u201CFui acionada por um alerta de integridade no controle de acesso.\u201D"
  - "\u201CEssas verifica\xE7\xF5es nem sempre aparecem como chamado formal.\u201D"
  narratorFeedbacks:
  - "\u201CVoc\xEA demonstra conhecer a din\xE2mica interna entre setores.\u201D"
  - "\u201CO termo t\xE9cnico parece leg\xEDtimo. A secret\xE1ria se lembra de falhas
    recentes.\u201D"
  - "\u201CVoc\xEA normaliza a aus\xEAncia de registros formais.\u201D"
  nextDialogue:
