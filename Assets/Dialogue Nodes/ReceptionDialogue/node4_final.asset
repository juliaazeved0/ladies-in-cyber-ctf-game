  m_Script: {fileID: 11500000, guid: fc344bf1847f7284ba70f62fdd0f60c5, type: 3}
  m_Name: node4_final
  m_EditorClassIdentifier: 
  question: "\u201CPode me explicar por que n\xE3o estou achando seus dados de acesso
    padr\xE3o aqui?\u201D"
  options:
  - "A) Meu cadastro ainda pode constar como desconhecido, estou come\xE7ando agora."
  - "B) Perdi meu crach\xE1 hoje, ainda n\xE3o consegui regularizar."
  - "C) Podemos resolver isso de outra forma\u2026"
  narratorFeedbacks:
  - "\u201CA explica\xE7\xE3o soa poss\xEDvel, mas ainda fr\xE1gil. Contudo, ela
    decide dar um voto de confian\xE7a.\u201D"
  - "\u201CEla hesita. Algo ainda n\xE3o fecha completamente, mas ela parece disposta
    a ajudar.\u201D"
  - "\u201CA insinua\xE7\xE3o foi clara demais. A conversa terminou ali. Lorena \xE9
    uma pessoa justa que n\xE3o aceita suborno.\u201D"
