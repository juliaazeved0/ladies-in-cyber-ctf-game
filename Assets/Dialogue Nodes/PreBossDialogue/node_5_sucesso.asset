  m_Script: {fileID: 11500000, guid: fc344bf1847f7284ba70f62fdd0f60c5, type: 3}
  m_Name: node_5_sucesso
  m_EditorClassIdentifier: 
  question: "\u201CAh, entendi. \xC9, o Dr. Rolf \xE9 complicado mesmo. Eu achei
    esse papel amassado perto da sala dele. Ia jogar fora mas se te ajuda a n\xE3o
    levar bronca, pode ficar com ele. Parece c\xF3digo, n\xE3o entendi nada.\u201D"
  options:
  - "A. \u201CMuito obrigado, Joana! Voc\xEA me salvou de uma boa."
  narratorFeedbacks:
  - "\u201CExcelente. Voc\xEA usou empatia e um bom pretexto para conseguir o que
    queria sem levantar alarmes. Agora voc\xEA tem o c\xF3digo.\u201D"
  nextDialogue: []
  buttonType: 1
