  m_Script: {fileID: 11500000, guid: fc344bf1847f7284ba70f62fdd0f60c5, type: 3}
  m_Name: node_3_acessoSala
  m_EditorClassIdentifier: 
  question: "\u201COlha, ele anota tudo em papel pra n\xE3o esquecer. Mas ele reclama
    que perde direto. Eu mesma j\xE1 vi ele bravo procurando senha em bloquinho.\u201D"
  options:
  - "A.  \u201CE o que ele faz com esses pap\xE9is quando n\xE3o precisa mais? Joga
    fora?\u201D"
  - "B. \u201CVoc\xEA j\xE1 precisou entrar na sala dele quando ele esquece de trancar?\u201D"
  - "C. \u201CEle muda essas senhas com frequ\xEAncia ou \xE9 s\xF3 quando o sistema
    obriga?\u201D"
  narratorFeedbacks:
  - " \u201CInvestigando o descarte de informa\xE7\xF5es. O lixo \xE9 uma mina de
    ouro.\u201D"
  - "\u201CSondando hor\xE1rios e oportunidades de acesso f\xEDsico.\u201D"
  - " \u201CUma pergunta t\xE9cnica disfar\xE7ada de curiosidade. Ela parece n\xE3o
    suspeitar.\u201D"
  nextDialogue:
